#include <stdio.h>

// Non-tail recursive function to calculate Fibonacci number
int fibonacci(int n) {
    if (n <= 1) {
        return n; // Base cases: Fibonacci(0) = 0, Fibonacci(1) = 1
    }
    return fibonacci(n - 1) + fibonacci(n - 2); // Recursive calls
}

int main() {
    int number = 10; // Example input
    printf("Fibonacci of %d is %d\n", number, fibonacci(number));
    return 0;
}
